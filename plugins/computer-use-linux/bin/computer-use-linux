#!/bin/sh
# Plugin launcher for Claude Code and Codex. Downloads the pinned release
# binaries on first use, verifies their bundled sha256 pins, caches them per
# version, then execs the server. stdout is left to the MCP stream; every
# message goes to stderr.
set -eu

version=0.7.10

say() {
  echo "computer-use-linux plugin: $*" >&2
}

if [ -n "${COMPUTER_USE_LINUX_BIN:-}" ]; then
  exec "$COMPUTER_USE_LINUX_BIN" "$@"
fi

case "$(uname -s)" in
  Linux) ;;
  *)
    say "unsupported platform: $(uname -s). This plugin only supports Linux."
    exit 64
    ;;
esac

case "$(uname -m)" in
  x86_64 | amd64) target=x86_64-unknown-linux-gnu ;;
  aarch64 | arm64) target=aarch64-unknown-linux-gnu ;;
  *)
    say "unsupported CPU architecture: $(uname -m). Supported: x86_64, aarch64."
    exit 64
    ;;
esac

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/computer-use-linux/plugin"
# Older launchers can still be running while a host updates this plugin. Their
# origin-verified writes must never replace files in the verified cache.
cache_dir="$cache_root/verified-v$version"
binary="$cache_dir/computer-use-linux"
helper="$cache_dir/computer-use-linux-cosmic"
pins="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/release-sha256.txt"

pinned_digest() {
  found=
  seen=' '
  count=0
  while IFS= read -r record || [ -n "$record" ]; do
    pin_version=${record%% *}
    remainder=${record#* }
    digest=${remainder%% *}
    asset=${remainder#* }
    if [ "$pin_version" != "$version" ] || [ "${#digest}" -ne 64 ]; then
      say "invalid or version-mismatched release pins"
      return 1
    fi
    case "$digest" in *[!a-f0-9]*) say "invalid release digest"; return 1 ;; esac
    case "$asset" in
      computer-use-linux-x86_64-unknown-linux-gnu|computer-use-linux-aarch64-unknown-linux-gnu|computer-use-linux-cosmic-x86_64-unknown-linux-gnu|computer-use-linux-cosmic-aarch64-unknown-linux-gnu) ;;
      *) say "invalid release pin asset"; return 1 ;;
    esac
    case "$seen" in *" $asset "*) say "duplicate release pin for $asset"; return 1 ;; esac
    seen="$seen$asset "
    count=$((count + 1))
    if [ "$asset" = "$1" ]; then
      found=$digest
    fi
  done < "$pins"
  [ "$count" -eq 4 ] && [ -n "$found" ] || { say "missing release pin for $1"; return 1; }
  printf '%s\n' "$found"
}

expected_binary=$(pinned_digest "computer-use-linux-$target")
expected_helper=$(pinned_digest "computer-use-linux-cosmic-$target")

fetch() {
  case "$1" in [hH][tT][tT][pP][sS]://*) ;; *) say "release downloads must use HTTPS"; return 1 ;; esac
  if ! command -v curl >/dev/null 2>&1; then
    say "curl is required for HTTPS-only release downloads"
    return 1
  fi
  curl --proto '=https' --proto-redir '=https' -fsSL --retry 2 -o "$2" "$1"
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

install_release() {
  base="${COMPUTER_USE_LINUX_DOWNLOAD_BASE:-https://github.com/agent-sh/computer-use-linux/releases/download/v$version}"
  mkdir -p "$cache_root"
  tmp=$(mktemp -d "$cache_root/.download.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  for name in computer-use-linux computer-use-linux-cosmic; do
    asset="$name-$target"
    say "downloading $asset v$version"
    fetch "$base/$asset" "$tmp/$name"
    case "$name" in
      computer-use-linux) expected=$expected_binary ;;
      computer-use-linux-cosmic) expected=$expected_helper ;;
    esac
    actual=$(sha256 "$tmp/$name")
    if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
      say "sha256 mismatch for $asset: expected ${expected:-<none>}, got $actual"
      exit 1
    fi
    chmod 0755 "$tmp/$name"
  done

  # Concurrent first starts each stage their own copy; rename keeps the swap
  # atomic, and the helper lands before the main binary that gates reuse.
  mkdir -p "$cache_dir"
  mv -f "$tmp/computer-use-linux-cosmic" "$helper"
  mv -f "$tmp/computer-use-linux" "$binary"
  rm -rf "$tmp"
  trap - EXIT INT TERM
}

if [ ! -x "$binary" ] || [ ! -x "$helper" ]; then
  install_release
fi

# Validate both files even on a cache hit before executing either.
if [ "$(sha256 "$binary")" != "$expected_binary" ] || [ "$(sha256 "$helper")" != "$expected_helper" ]; then
  say "sha256 mismatch in cached release; remove $cache_dir and retry"
  exit 1
fi

# Claude Code and Codex update plugins independently, so another version may
# still be in use. Mark this one live and drop versions unused for 30 days,
# plus staging dirs left by a killed download.
touch "$cache_dir"
find "$cache_root" -mindepth 1 -maxdepth 1 \
  \( \( \( -name 'v*' -o -name 'verified-v*' \) ! -path "$cache_dir" -mtime +30 \) -o \( -name '.download.*' -mmin +60 \) \) \
  -exec rm -rf {} + 2>/dev/null || true

if [ -z "${COMPUTER_USE_LINUX_COSMIC_HELPER:-}" ]; then
  COMPUTER_USE_LINUX_COSMIC_HELPER="$helper"
  export COMPUTER_USE_LINUX_COSMIC_HELPER
fi

exec "$binary" "$@"
